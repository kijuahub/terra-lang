package com.example.files;

use com.terra.fs;
use com.terra.os;
use com.terra.path;

func main(args: string[]) {
    var root = path.join(os.tmp(), "terra-example-files-" + to_string(os.pid()));
    fs.mkdir(root);
    var file = path.join(root, "note.txt");
    fs.write_text(file, "hello files");
    println(fs.read_text(file));
    fs.remove(root);
}
