package com.example.zip;

use com.terra.archive;
use com.terra.fs;
use com.terra.os;
use com.terra.path;

func main(args: string[]) {
    var z = path.join(os.tmp(), "terra-example-zip-" + to_string(os.pid()) + ".zip");
    if (fs.exists(z)) {
        fs.remove(z);
    }
    archive.add(z, "a.txt", "alpha");
    println(archive.read(z, "a.txt"));
    fs.remove(z);
}
