package com.example.sqlite;

use com.terra.sqlite;
use com.terra.fs;
use com.terra.os;
use com.terra.path;

func main(args: string[]) {
    var dbpath = path.join(os.tmp(), "terra-example-sql-" + to_string(os.pid()) + ".db");
    if (fs.exists(dbpath)) {
        fs.remove(dbpath);
    }
    var db = sqlite.open(dbpath);
    sqlite.exec(db, "create table notes(body text); insert into notes(body) values ('hello');");
    println(sqlite.query(db, "select body from notes"));
    sqlite.close(db);
    fs.remove(dbpath);
}
