package com.example.sqlite;

use com.terra.sqlite;
use com.terra.fs;
use com.terra.os;
use com.terra.path;

func main(args: string[]) {
    var dbpath = path_join(os_tmp(), "terra-example-sql-" + to_string(os_pid()) + ".db");
    if (fs_exists(dbpath)) {
        fs_remove(dbpath);
    }
    var db = sqlite_open(dbpath);
    sqlite_exec(db, "create table notes(body text); insert into notes(body) values ('hello');");
    println(sqlite_query(db, "select body from notes"));
    sqlite_close(db);
    fs_remove(dbpath);
}
